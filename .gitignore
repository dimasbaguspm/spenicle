.env

# runtime data: the sqlite file, WAL sidecars and sealed artifacts
/data/
*.db
*.db-shm
*.db-wal

# build output
/bin/
/spenicle
coverage.out

# supervision artefacts: the runtime state runit writes and the `down` marker
# that disables a service. config/runit/** stays tracked: those are the sources
# the image copies into /etc/service.
/run/
down

# the local dev APP_SECRET, generated once by `make dev`
/.dev-secret
