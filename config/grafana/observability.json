{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "RED — availability",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Successful answers over all answers in the window. Green at 99 %, amber at 95 %.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "100 * sum(rate(spenicle_http_server_requests_total{http_response_status_code!~\"5..\"}[5m]))\n/ sum(rate(spenicle_http_server_requests_total[5m]))",
          "instant": false,
          "legendFormat": "availability",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Availability now",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "The same ratio over time: a dip is a window the user felt.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No requests",
          "custom": {
            "axisLabel": "",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "max": 100,
          "min": 90,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 18, "x": 6, "y": 1 },
      "id": 3,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["min", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "100 * sum(rate(spenicle_http_server_requests_total{http_response_status_code!~\"5..\"}[5m]))\n/ sum(rate(spenicle_http_server_requests_total[5m]))",
          "legendFormat": "success ratio",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Success ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Requests per second as the router matched them. http_route is the template, never the raw path.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No requests",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "none" } },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (http_route) (rate(spenicle_http_server_requests_total[5m]))",
          "legendFormat": "{{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request rate by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Share of 5xx per route: an answer that says the server failed.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No requests",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "100 * sum by (http_route) (rate(spenicle_http_server_requests_total{http_response_status_code=~\"5..\"}[5m]))\n/ sum by (http_route) (rate(spenicle_http_server_requests_total[5m]))",
          "legendFormat": "{{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error rate (5xx) by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Share of 4xx per route: a client that is wrong is not the server failing.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No requests",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "100 * sum by (http_route) (rate(spenicle_http_server_requests_total{http_response_status_code=~\"4..\"}[5m]))\n/ sum by (http_route) (rate(spenicle_http_server_requests_total[5m]))",
          "legendFormat": "{{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Client error rate (4xx) by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "p50, p90, p95 and p99 of the wall clock time to answer, by route template.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No requests",
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, http_route) (rate(spenicle_http_server_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{http_route}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.90, sum by (le, http_route) (rate(spenicle_http_server_duration_seconds_bucket[5m])))",
          "legendFormat": "p90 {{http_route}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(spenicle_http_server_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{http_route}}",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, http_route) (rate(spenicle_http_server_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{http_route}}",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Latency quantiles by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "The mean the histogram carries: _sum over _count.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No requests",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 24 },
      "id": 8,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (http_route) (rate(spenicle_http_server_duration_seconds_sum[5m]))\n/ sum by (http_route) (rate(spenicle_http_server_duration_seconds_count[5m]))",
          "legendFormat": "{{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Average latency by route",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 9,
      "panels": [],
      "title": "Every route in one glance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "One row per http.route: request rate, error rate, average and p95 over the last five minutes. Sorted by error rate.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "req/s" },
            "properties": [{ "id": "unit", "value": "reqps" }]
          },
          {
            "matcher": { "id": "byName", "options": "error %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 1 },
                    { "color": "red", "value": 5 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "avg s" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "p95 s" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 32 },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "error %" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (http_route) (rate(spenicle_http_server_requests_total[5m]))",
          "format": "table",
          "instant": true,
          "legendFormat": "req/s",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "100 * sum by (http_route) (rate(spenicle_http_server_requests_total{http_response_status_code=~\"5..\"}[5m]))\n/ sum by (http_route) (rate(spenicle_http_server_requests_total[5m]))",
          "format": "table",
          "instant": true,
          "legendFormat": "error %",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (http_route) (rate(spenicle_http_server_duration_seconds_sum[5m]))\n/ sum by (http_route) (rate(spenicle_http_server_duration_seconds_count[5m]))",
          "format": "table",
          "instant": true,
          "legendFormat": "avg s",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(spenicle_http_server_duration_seconds_bucket[5m])))",
          "format": "table",
          "instant": true,
          "legendFormat": "p95 s",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "Routes: rate, errors, latency",
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": {
              "Value #A": "req/s",
              "Value #B": "error %",
              "Value #C": "avg s",
              "Value #D": "p95 s",
              "http_route": "route"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "desc": true, "field": "error %" }]
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "id": 11,
      "panels": [],
      "title": "Saturation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Requests being served right now, by route.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No requests",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 43 },
      "id": 12,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (http_route) (spenicle_http_server_in_flight)",
          "legendFormat": "{{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "In-flight requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Operations that lost the SQLite write lock, by open|begin|write|commit. A steady rate means two processes are contending for the one writer.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 43 },
      "id": 13,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (spenicle_operation) (rate(spenicle_sqlite_locked_total[5m]))",
          "legendFormat": "{{spenicle_operation}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "SQLite lock retries",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 },
      "id": 14,
      "panels": [],
      "title": "Worker",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "One tick of the worker, per step and outcome. spenicle_job is recurring|artifacts|imports|exports|sweep.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 51 },
      "id": 15,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (spenicle_job, spenicle_outcome) (rate(spenicle_worker_runs_total[5m]))",
          "legendFormat": "{{spenicle_job}} {{spenicle_outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Worker runs by job and outcome",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Items a step handled: rules posted, artifacts reclaimed, rows parsed, jobs rendered.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 51 },
      "id": 16,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (spenicle_job) (rate(spenicle_worker_items_total[5m]))",
          "legendFormat": "{{spenicle_job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Worker items by job",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "p95 wall clock time of one worker step.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 59 },
      "id": 17,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, spenicle_job) (rate(spenicle_worker_run_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{spenicle_job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Worker run duration p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Seconds since worker_last_run_at, the row /healthz reports. Nothing exports spenicle_worker_last_run_timestamp_seconds today: publish it with a textfile exporter or a probe of GET /healthz, otherwise this panel stays empty.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3900 },
              { "color": "red", "value": 7200 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 59 },
      "id": 18,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "time() - max(spenicle_worker_last_run_timestamp_seconds)",
          "legendFormat": "heartbeat age",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Worker heartbeat age",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 66 },
      "id": 19,
      "panels": [],
      "title": "Domain",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Capture is not ledger: this is what approval wrote, by entry source.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 67 },
      "id": 20,
      "interval": "1m",
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
