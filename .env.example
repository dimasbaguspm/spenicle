# Every variable this process reads. Un-prefixed on purpose: if several
# self-hosted services share one env file, qualify them yourself.
#
# Copy to .env and fill in the required ones:
#   cp .env.example .env
#
# APP_SECRET is the only hard requirement. It seals capture payloads, the user's
# password and the settings row, and identifies the database.
#
# The base currency and the login password are NOT environment variables: they live
# in the app's settings table. A fresh boot generates the first password and prints
# it once; you change it after signing in.

# --- required -------------------------------------------------------------

# >= 16 bytes. Generate once, back it up next to the database, never commit it.
#   openssl rand -base64 32
APP_SECRET=

# --- storage and network --------------------------------------------------

# Where spenicle.db and raw/ artifacts live.
DATA_DIR=./data

# Listen address.
ADDR=:8080

# --- extraction (optional) ------------------------------------------------

# Extraction rail. Two are implemented and they share one contract:
#   SNAPTOJSON_API_KEY set -> snaptojson (submit + poll)
#   OPENAI_API_KEY set     -> openai     (single vision call)
# Neither set = captures stay raw and you type the fields yourself.
SNAPTOJSON_API_KEY=

# Optional: point the adapter at a proxy or a staging account instead of the
# documented production route.
# SNAPTOJSON_ENDPOINT=https://api.snaptojson.com/partner/v1/snaps

# The OpenAI rail. Used only when SNAPTOJSON_API_KEY is unset: one vision call per
# document, no polling. Model defaults to gpt-4o-mini.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- observability (optional) ---------------------------------------------

# OTLP/HTTP collector. Empty disables tracing and metrics entirely (no-ops).
# https:// is the assumption: a bare host is treated as HTTPS, http:// has to be
# written on purpose, and port 4318 is used when none is given.
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# The one frontend origin allowed to send the session cookie with credentials.
# Empty means same-origin only; set it for a separate dev server, e.g. http://localhost:5173
WEB_ORIGIN=
