# Every variable this process reads. Un-prefixed on purpose: if several
# self-hosted services share one env file, qualify them yourself.
#
# Copy to .env and fill in the required ones:
#   cp .env.example .env
#
# APP_SECRET is the only hard requirement. It seals capture payloads and
# identifies the database: lose it and the sealed half of the data is gone.

# --- required -------------------------------------------------------------

# >= 16 bytes. Generate once, back it up next to the database, never commit it.
#   openssl rand -base64 32
APP_SECRET=

# --- storage and network --------------------------------------------------

# Where spenicle.db and raw/ artifacts live.
DATA_DIR=./data

# Listen address.
ADDR=:8080

# Base currency, ISO 4217. Locked at first boot; a later value must match or boot fails.
BASE_CURRENCY=IDR

# --- single user ----------------------------------------------------------

# Enables the login screen. Empty means open to whoever can reach the port.
PASSWORD=

# --- extraction (optional) ------------------------------------------------

# Enables the SnapToJSON extraction vendor. Empty = captures stay raw and you
# type the fields yourself, which is the honest default for self-hosting.
SNAPTOJSON_API_KEY=

# Optional: point the adapter at a proxy or a staging account instead of the
# documented production route.
# SNAPTOJSON_ENDPOINT=https://api.snaptojson.com/partner/v1/snaps

# --- observability (optional) ---------------------------------------------

# OTLP/HTTP collector. Empty disables tracing and metrics entirely (no-ops).
# https:// is the assumption: a bare host is treated as HTTPS, http:// has to be
# written on purpose, and port 4318 is used when none is given.
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Not read by spenicle; set by the OpenTelemetry SDK if you need to override the
# exporter's own headers or timeout behaviour.
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TIMEOUT=
