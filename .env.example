# Every variable spenicle reads. Copy to .env and fill in APP_SECRET:
#   cp .env.example .env
# Everything else is optional; the container writes to /data.

# Required. >= 16 bytes; seals capture payloads, artifacts and the settings row.
#   openssl rand -base64 32
APP_SECRET=

# IANA timezone for every calendar decision. Default: UTC. Set once, at the first boot.
APP_TIMEZONE=

# Extraction rail 1 (submit + poll). Unset keeps captures manual.
SNAPTOJSON_API_KEY=
# Override the SnapToJSON route. Default: https://api.snaptojson.com/partner/v1/snaps
SNAPTOJSON_ENDPOINT=

# Extraction rail 2 is reserved: the adapter is wired by tests only.
# config.SelectRail never selects it, even when SNAPTOJSON_API_KEY is unset.
OPENAI_API_KEY=
# Reserved adapter settings: defaults are https://api.openai.com/v1 and gpt-4o-mini;
# empty HOST keeps the SDK default.
OPENAI_HOST=
OPENAI_MODEL=

# OTLP/HTTP collector. Empty disables tracing and metrics. Default: unset (no-op).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Limits. Every one has the default in internal/common/config/config.go; set it only to
# override. Sizes are bytes, durations are Go durations (720h, 30m).
APP_MAX_BODY_BYTES=
APP_ARTIFACT_MAX_BYTES=
APP_IMPORT_MAX_BYTES=
APP_ARTIFACT_RETENTION=
APP_EXPORT_RETENTION=
APP_WORKER_INTERVAL=
APP_HEALTH_TIMEOUT=
APP_IMPORT_COMMIT_CHUNK=
