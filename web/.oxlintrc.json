{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "promise",
    "vitest",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off",
    "nursery": "off"
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-else-return": "error",
    "no-implicit-coercion": "error",
    "no-param-reassign": "error",
    "no-shadow": "error",
    "no-throw-literal": "error",
    "no-unneeded-ternary": "error",
    "no-useless-rename": "error",
    "object-shorthand": "error",
    "prefer-template": "error",
    "radix": "error",
    "react/jsx-key": "error",
    "react/rules-of-hooks": "error",
    "react/jsx-boolean-value": ["error", "never"],
    "react/self-closing-comp": "error",
    "react/jsx-fragments": ["error", "syntax"],
    "react/no-array-index-key": "error",
    "react/no-danger": "error",
    "react/button-has-type": "error",
    "react/no-unstable-nested-components": "error",
    "react/no-unknown-property": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-empty-object-type": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/require-number-to-fixed-digits-argument": "error",
    "unicorn/no-array-callback-reference": "error",
    "unicorn/no-useless-undefined": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/first": "error",
    "import/no-self-import": "error",
    "promise/no-return-in-finally": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ],
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@ark-ui/react",
            "message": "compose a Ui component instead of importing Ark directly"
          }
        ],
        "patterns": [
          {
            "group": ["@ark-ui/*"],
            "message": "compose a Ui component instead of importing Ark directly"
          }
        ]
      }
    ],
    "react-perf/jsx-no-jsx-as-prop": "off"
  },
  "overrides": [
    {
      "files": ["src/components/primitives/button/index.tsx"],
      "rules": {
        "react/button-has-type": "off"
      }
    },
    {
      "files": ["src/components/primitives/**/*.tsx", "src/components/primitives/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/components/ui/*", "@/components/layouts/*", "@/modules/*"],
                "message": "primitives are the bottom layer: Ark plus the palette, nothing above it"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/ui/**/*.tsx", "src/components/ui/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@ark-ui/react",
                "message": "compose a primitives component instead of importing Ark directly"
              }
            ],
            "patterns": [
              { "group": ["@ark-ui/*"], "message": "compose a primitives component instead" },
              {
                "group": ["@/components/layouts/*", "@/modules/*"],
                "message": "ui sits above primitives and below layouts and modules: it may not reach up"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/modules/**/*.tsx", "src/modules/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@ark-ui/react",
                "message": "compose a primitives component instead of importing Ark directly"
              }
            ],
            "patterns": [
              { "group": ["@ark-ui/*"], "message": "compose a primitives component instead" },
              {
                "group": ["@/routes/*", "@/router", "@/hooks/*"],
                "message": "a module owns its entity and is placed by a route; it never reaches for one"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/providers/**/*.tsx", "src/providers/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@ark-ui/react",
                "message": "compose a primitives component instead of importing Ark directly"
              }
            ],
            "patterns": [
              { "group": ["@ark-ui/*"], "message": "compose a primitives component instead" },
              {
                "group": ["@/routes/*", "@/router"],
                "message": "a provider wraps the router and its pages; it may not reach into them"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["vite.config.ts", "src/test/**/*.ts", "**/*.test.tsx"],
      "rules": {
        "import/no-default-export": "off",
        "no-console": "off"
      }
    }
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "dev-dist/**", "src/types/generated/**", "node_modules/**"]
}
